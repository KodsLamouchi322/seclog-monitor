{
  "index_patterns": ["logs-security-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "5s"
    },
    "mappings": {
      "dynamic_templates": [
        { "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 512 } } }
      ],
      "properties": {
        "@timestamp":  { "type": "date" },
        "ingested_at": { "type": "date" },
        "message": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "result":         { "type": "keyword" },
        "severity":       { "type": "keyword" },
        "severity_score": { "type": "byte" },
        "event": { "properties": {
          "type": { "type": "keyword" }, "category": { "type": "keyword" }, "action": { "type": "keyword" } } },
        "user": { "properties": { "name": { "type": "keyword" }, "role": { "type": "keyword" } } },
        "source": { "properties": {
          "ip":   { "type": "ip" },
          "port": { "type": "integer" },
          "geo": { "properties": {
            "location":         { "type": "geo_point" },
            "country_iso_code": { "type": "keyword" },
            "country_name":     { "type": "keyword" },
            "city_name":        { "type": "keyword" } } } } },
        "upload": { "properties": { "file_name": { "type": "keyword" } } },
        "tags": { "type": "keyword" }
      }
    }
  }
}
