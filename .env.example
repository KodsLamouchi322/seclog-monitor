# Copier ce fichier en .env (ignoré par Git) puis adapter les valeurs.

# Versions et ressources
STACK_VERSION=8.15.3
ES_HEAP=512m

# Ports publiés sur l'hôte
WEB_PORT=8000
KIBANA_PORT=5601

# Application web
SECRET_KEY=change-me-long-random-string

# MongoDB
MONGO_USER=seclog
MONGO_PASSWORD=change-me-mongo
MONGO_DB=seclog

# Redis
REDIS_PASSWORD=change-me-redis

# Alerting (module G, sprint 5)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=

ADMIN_TOKEN=change-me-admin
